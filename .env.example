# Copy to .env (gitignored) and fill in for your machine.
# Loaded automatically by calcium2p.core.paths via python-dotenv, so the CLI and
# notebooks work without a shell export.

# Root of the local data tree. All session paths are resolved relative to this,
# so no absolute path is ever hardcoded in tracked code.
#   $DATA_ROOT/<study>/<subject>/<session>/<run>/...
DATA_ROOT=/path/to/your/Data

# Where pipeline outputs and intermediate artifacts are written.
# Defaults to $DATA_ROOT/derivatives when unset.
# DERIVATIVES_ROOT=/path/to/your/Data/derivatives

# Recorded in provenance.json so an output can be traced to a person.
# Falls back to `git config user.name` / `user.email` when unset.
# OPERATOR_NAME=Rei Masuda
# OPERATOR_GITHUB=raymasooda

# Logging verbosity for CLI scripts: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
